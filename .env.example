# Database (SQLite for local dev; switch provider to "postgresql" in prisma/schema.prisma for production)
DATABASE_URL="file:../data/dev.db"

# The domain the platform runs on. Broker sites are served at <slug>.<ROOT_DOMAIN>
# and on custom domains that point here. For local dev, *.localhost resolves to 127.0.0.1
# in modern browsers, so http://maria-lopez.localhost:3000 works out of the box.
ROOT_DOMAIN="localhost:3000"
PUBLIC_PROTOCOL="http"

# Claude (AI listing descriptions, natural-language search, chat widget, auto-replies, logo concepts).
# Without a key the platform uses deterministic fallbacks so everything still works.
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-opus-5-5
# AI_MODEL="claude-opus-5-5"

# Outbound email. Format: smtp://user:pass@host:587 . Without it, emails are logged to the Outbox.
SMTP_URL=""
MAIL_FROM="Brokersite <no-reply@brokersite.app>"

# WhatsApp notifications via Twilio. Without these, WhatsApp messages are logged to the Outbox.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""   # e.g. whatsapp:+14155238886

# Where uploaded logos/photos are stored on disk (swap for S3/R2 in production)
UPLOAD_DIR="./data/uploads"
